# 词迹 — 前端可读配置（client_id 可公开，client_secret 禁止出现在前端）

# 墨墨 OIDC（纯前端 PKCE，不要填写 client_secret）
VITE_MAIMEMO_CLIENT_ID=
VITE_MAIMEMO_ISSUER=https://accounts.maimemo.com/oidc
VITE_MAIMEMO_SCOPE=openid profile
# 留空则自动使用当前站点 origin + /auth/callback
# 示例（GitHub Pages 仓库名为 ciji）:
# VITE_MAIMEMO_REDIRECT_URI=https://<username>.github.io/ciji/auth/callback
VITE_MAIMEMO_REDIRECT_URI=

# MiMo — 不要把 API Key 写进 .env 再提交。
# API Key 只在 App 设置页填写，保存在本机 IndexedDB。
# VITE_MIMO_API_KEY=

# 可选：Cloudflare Worker 中继（当 MiMo 浏览器 CORS 不可用时）
# 例如 https://ciji-ai.<your-subdomain>.workers.dev/api/ai
VITE_AI_RELAY_URL=

# GitHub Pages 仓库名（用于 Actions 构建 base）；fork 后请改成你的仓库名
# VITE_BASE=./
