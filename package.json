{
  "name": "ciji",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && gradlew assembleRelease",
    "keystore:init": "powershell -File scripts/init-keystore.ps1",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "dexie": "^4.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.0.3"
  }
}
